<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  {{> header}}
</head>
<body>
  <table>
            <thead>
                <tr>
                    <th>name</th>
                    <th>category</th>
                    <th>stock</th>
                    <th>active</th>
                    <th>editar</th>
                </tr>
            </thead>

            <tbody>
                {{#each products}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{category}}</td>
                    <td>{{stock}}</td>
                    <td>{{active}}</td>
                    <td><a href="/productsEdit?id={{id}}">Editar</a></td>
                    {{/each}}
                </tr>
            </tbody>
        </table>
        <div class="pagination">

          <a href="/anterior?numpagina={{currentPage}}">Anterior</a>

          <a href="/siguiente?numpagina={{currentPage}}">Siguiente</a>

        </div> 

        <input type="checkbox" type="hidden" id="toggleSearch" class="toggle-search oculto">
        <label for="toggleSearch" class="buscar">Cerca</label>



<div id="searchPanel" style="display:none;">
<form method="GET" action="/productes">
  <label>Buscar per nom</label>
  <input type="text" name="cerca" placeholder="Nom del producte">
  <input type="hidden" name="pagina" value="1">
  <button type="submit">Buscar</button>
</form>

<form method="GET" action="/productes">
  <label>Buscar per categoria</label>
  <input type="text" name="categoria" placeholder="Categoria">
  <input type="hidden" name="pagina" value="1">
  <button type="submit">Buscar</button>
</form>
</div>

<form method="POST" action="/create" class="form-grid">
  <input type="hidden" name="table" value="products"/>

  <label for="name">Nombre</label>
  <input type="text" id="name" name="name" required>

  <label for="category">Categoría</label>
  <input type="text" id="category" name="category" required>

  <label for="price">Precio</label>
  <input type="number" id="price" name="price" min="0" step="0.01" required>

  <label for="stock">Stock</label>
  <input type="number" id="stock" name="stock" min="0" required>

  <button type="submit">Añadir Producto</button>
</form>




<script src="scrip.js"></script>



</body>
</html>
